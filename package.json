{
	"name": "morph-status-svelte",
	"version": "0.1.0",
	"description": "A morphing status icon for Svelte 5. One stroke pours between idle, loading, success, error, and warning.",
	"license": "MIT",
	"author": "Emil Majer (https://github.com/EmilM32)",
	"type": "module",
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"status",
		"icon",
		"morph",
		"spinner",
		"animation",
		"spring",
		"a11y"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EmilM32/morph-status-svelte.git"
	},
	"homepage": "https://morph-status-svelte.vercel.app",
	"bugs": {
		"url": "https://github.com/EmilM32/morph-status-svelte/issues"
	},
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 4731",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4731",
		"prepare": "svelte-kit sync || echo ''",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint ."
	},
	"files": ["dist", "docs/demo.png", "!dist/**/*.test.*", "!dist/**/*.spec.*"],
	"sideEffects": ["**/*.css"],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"eslint": "^9.39.1",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.4.0",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.46.2",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
